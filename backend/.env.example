# ==============================================================================
# CarDD Backend Environment Configuration
# Copy this file to .env before starting the container:
#   cp .env.example .env
# ==============================================================================

# Port the backend listens on
PORT=7000

# Secret API key for authenticating incoming requests
# Generate a strong key (e.g. openssl rand -hex 32)
CARDD_API_KEY=cardd_secret_key_change_me_in_production

# Model selection (tflite or onnx)
MODEL_PATH=/app/model/yolov8n.tflite

# Maximum upload image size (25 MB = 26214400 bytes)
MAX_IMAGE_SIZE_BYTES=26214400

# Detection & NMS thresholds
DEFAULT_CONF_THRESHOLD=0.25
DEFAULT_IOU_THRESHOLD=0.45
MAX_DETECTIONS=300

# Vehicle-presence gate: rejects uploads that don't plausibly contain a car (e.g. a laptop/desk
# photo) with 422 before running damage inference. See app/services/vehicle_classifier.py.
VEHICLE_CLASSIFIER_ENABLED=true
VEHICLE_CLASSIFIER_MODEL_PATH=/app/model/mobilenetv2_imagenet.onnx
VEHICLE_PROB_THRESHOLD=0.02
