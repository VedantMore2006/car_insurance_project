# Copy to .env and fill in real values for local development. Never commit a real .env.
# This Phase One build does NOT read process.env at runtime (no react-native-config wired up yet);
# the backend URL is instead configured at runtime from the Settings screen and persisted via
# AsyncStorage. This file documents the expected variable for when env-based config is added.

# Base URL of the detection backend. Must NOT be "localhost" when testing on a physical device —
# localhost on a physical Android device refers to the device itself, not your development machine.
# Use your machine's LAN IP (e.g. http://192.168.1.50:8000) or `adb reverse` for an emulator, or a
# real deployed backend URL.
API_BASE_URL=https://your-backend.example.com
